model StudyProgram {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique @db.VarChar(30)
  name            String              @db.VarChar(180)
  degree          String              @db.VarChar(20)
  unit            String              @db.VarChar(180)
  headLecturerId  String?             @map("head_lecturer_id") @db.Uuid
  status          AcademicRecordStatus @default(ACTIVE)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  headLecturer    Lecturer?           @relation("ProgramHead", fields: [headLecturerId], references: [id], onDelete: Restrict)
  lecturers       Lecturer[]          @relation("LecturerProgram")
  students        Student[]
  curricula       Curriculum[]
  courses         Course[]
  graduationRules GraduationRule[]
  admissionPrograms AdmissionProgram[]
  tariffs           Tariff[]

  @@map("study_programs")
}

model Lecturer {
  id              String              @id @default(uuid()) @db.Uuid
  nidn            String              @unique @db.VarChar(30)
  nip             String?             @unique @db.VarChar(30)
  name            String              @db.VarChar(180)
  title           String              @db.VarChar(100)
  titleFront      String?             @map("title_front") @db.VarChar(80)
  titleBack       String?             @map("title_back") @db.VarChar(80)
  email           String?             @unique @db.VarChar(320)
  phone           String?             @db.VarChar(30)
  studyProgramId  String              @map("study_program_id") @db.Uuid
  status          AcademicRecordStatus @default(ACTIVE)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  studyProgram    StudyProgram        @relation("LecturerProgram", fields: [studyProgramId], references: [id], onDelete: Restrict)
  headedPrograms  StudyProgram[]      @relation("ProgramHead")
  offerings       ClassOffering[]

  @@index([studyProgramId, status])
  @@map("lecturers")
}

model Curriculum {
  id             String           @id @default(uuid()) @db.Uuid
  code           String?          @unique @db.VarChar(40)
  studyProgramId String           @map("study_program_id") @db.Uuid
  name           String           @db.VarChar(180)
  effectiveYear  Int              @map("effective_year")
  endYear        Int?             @map("end_year")
  status         CurriculumStatus @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  studyProgram   StudyProgram     @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  courses        CurriculumCourse[]

  @@unique([studyProgramId, effectiveYear])
  @@map("curricula")
}

model Course {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique @db.VarChar(30)
  name           String       @db.VarChar(180)
  credits        Int
  semester       Int
  studyProgramId String       @map("study_program_id") @db.Uuid
  kind           CourseKind
  description    String?      @db.VarChar(1000)
  status         AcademicRecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  studyProgram   StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  curricula      CurriculumCourse[]
  prerequisites  CoursePrerequisite[] @relation("CoursePrerequisites")
  requiredBy     CoursePrerequisite[] @relation("CourseRequiredBy")
  offerings      ClassOffering[]

  @@index([studyProgramId, semester])
  @@map("courses")
}

model CurriculumCourse {
  curriculumId String     @map("curriculum_id") @db.Uuid
  courseId     String     @map("course_id") @db.Uuid
  semester     Int?
  nature       CurriculumCourseNature?
  credits      Int?
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([curriculumId, courseId])
  @@index([courseId])
  @@map("curriculum_courses")
}

model CoursePrerequisite {
  courseId       String @map("course_id") @db.Uuid
  prerequisiteId String @map("prerequisite_id") @db.Uuid
  course         Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite   Course @relation("CourseRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  @@id([courseId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("course_prerequisites")
}

model ClassOffering {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique @db.VarChar(50)
  courseId       String          @map("course_id") @db.Uuid
  lecturerId     String          @map("lecturer_id") @db.Uuid
  academicYear   String          @map("academic_year") @db.VarChar(20)
  term           AcademicTerm
  className      String          @map("class_name") @db.VarChar(80)
  capacity       Int
  status         OfferingStatus  @default(OPEN)
  room           String?         @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lecturer       Lecturer        @relation(fields: [lecturerId], references: [id], onDelete: Restrict)
  schedules      ClassSchedule[]
  krsItems       KrsItem[]
  grades         GradeRecord[]
  attendance     AttendanceSummary[]
  attendanceRecords AttendanceRecord[]

  @@unique([courseId, academicYear, term, className])
  @@index([lecturerId, academicYear, term])
  @@map("class_offerings")
}

model ClassSchedule {
  id          String         @id @default(uuid()) @db.Uuid
  offeringId  String         @map("offering_id") @db.Uuid
  day         String         @db.VarChar(12)
  start       String         @db.VarChar(5)
  end         String         @db.VarChar(5)
  room        String         @db.VarChar(100)
  status      ScheduleStatus @default(CONFIRMED)
  offering    ClassOffering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([day, start, end])
  @@index([room, day])
  @@map("class_schedules")
}

model KrsRecord {
  id             String     @id @default(uuid()) @db.Uuid
  studentId      String     @map("student_id") @db.Uuid
  academicYear   String     @map("academic_year") @db.VarChar(20)
  term           AcademicTerm
  status         KrsStatus  @default(DRAFT)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  items          KrsItem[]
  statusHistory  KrsStatusHistory[]

  @@unique([studentId, academicYear, term])
  @@map("krs_records")
}

model KrsStatusHistory {
  id          String    @id @default(uuid()) @db.Uuid
  krsId       String    @map("krs_id") @db.Uuid
  oldStatus   KrsStatus @map("old_status")
  newStatus   KrsStatus @map("new_status")
  reason      String?   @db.VarChar(500)
  actorLabel  String    @default("Administrator") @map("actor_label") @db.VarChar(180)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  krs         KrsRecord @relation(fields: [krsId], references: [id], onDelete: Cascade)

  @@index([krsId, createdAt])
  @@map("krs_status_history")
}

model KrsItem {
  krsId       String        @map("krs_id") @db.Uuid
  offeringId  String        @map("offering_id") @db.Uuid
  krs         KrsRecord     @relation(fields: [krsId], references: [id], onDelete: Cascade)
  offering    ClassOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@id([krsId, offeringId])
  @@index([offeringId])
  @@map("krs_items")
}

model GradeRecord {
  id          String      @id @default(uuid()) @db.Uuid
  studentId   String      @map("student_id") @db.Uuid
  offeringId  String      @map("offering_id") @db.Uuid
  assignment  Decimal     @default(0) @db.Decimal(5, 2)
  midterm     Decimal     @default(0) @db.Decimal(5, 2)
  finalExam   Decimal     @default(0) @map("final_exam") @db.Decimal(5, 2)
  finalScore  Decimal     @default(0) @map("final_score") @db.Decimal(5, 2)
  grade       String      @default("-") @db.VarChar(3)
  status      GradeStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  offering    ClassOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@unique([studentId, offeringId])
  @@map("grade_records")
}

model AttendanceSummary {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @map("student_id") @db.Uuid
  offeringId  String        @map("offering_id") @db.Uuid
  meetings    Int           @default(0)
  present     Int           @default(0)
  excused     Int           @default(0)
  sick        Int           @default(0)
  absent      Int           @default(0)
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  offering    ClassOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@unique([studentId, offeringId])
  @@map("attendance_summaries")
}

model AttendanceRecord {
  id            String        @id @default(uuid()) @db.Uuid
  studentId     String        @map("student_id") @db.Uuid
  offeringId    String        @map("offering_id") @db.Uuid
