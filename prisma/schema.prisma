model Tariff {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(40)
  name           String   @db.VarChar(180)
  kind           String   @db.VarChar(80)
  studyProgramId String?  @map("study_program_id") @db.Uuid
  pathway        String?  @db.VarChar(120)
  semester       Int
  academicYear   String   @map("academic_year") @db.VarChar(9)
  amount         Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  studyProgram   StudyProgram? @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  billings       Billing[]
  history        TariffHistory[]

  @@index([academicYear, studyProgramId, active])
  @@map("tariffs")
}

model Scholarship {
  id           String           @id @default(uuid()) @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  kind         String           @db.VarChar(120)
  academicYear String           @map("academic_year") @db.VarChar(9)
  amount       Int
  provider     String           @db.VarChar(180)
  startsAt     DateTime         @map("starts_at") @db.Date
  endsAt       DateTime         @map("ends_at") @db.Date
  status       ScholarshipStatus @default(PENDING_VERIFICATION)
  documentName String?          @map("document_name") @db.VarChar(255)
  note         String?          @db.VarChar(1000)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  billings     Billing[]
  history      ScholarshipHistory[]

  @@unique([studentId, academicYear, kind])
  @@index([academicYear, status])
  @@index([studentId, academicYear])
  @@map("scholarships")
}

model Reconciliation {
  id                String               @id @default(uuid()) @db.Uuid
  transactionDate   DateTime             @map("transaction_date") @db.Date
  externalReference String               @map("external_reference") @db.VarChar(120)
  billingNumber     String               @map("billing_number") @db.VarChar(40)
  studentNim        String               @map("student_nim") @db.VarChar(30)
  internalAmount    Int?                 @map("internal_amount")
  externalAmount    Int                  @map("external_amount")
  paymentMethod     String               @map("payment_method") @db.VarChar(80)
  status            ReconciliationStatus @default(PENDING)
  paymentId         String?              @map("payment_id") @db.Uuid
  note              String?              @db.VarChar(1000)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  history           ReconciliationHistory[]

  @@unique([externalReference, paymentMethod])
  @@index([transactionDate, status])
  @@index([paymentId])
  @@map("reconciliations")
}

model TariffHistory {
  id         String   @id @default(uuid()) @db.Uuid
  tariffId   String   @map("tariff_id") @db.Uuid
  actorLabel String   @default("Administrator Back Office") @map("actor_label") @db.VarChar(180)
