model CeremonyRegistration {
  id              String                     @id @default(uuid()) @db.Uuid
  ceremonyId      String                     @map("ceremony_id") @db.Uuid
  studentId       String                     @map("student_id") @db.Uuid
  status          CeremonyRegistrationStatus @default(REGISTERED)
