  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tariff     Tariff   @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@index([tariffId, createdAt])
  @@map("tariff_history")
}

model ScholarshipHistory {
  id            String      @id @default(uuid()) @db.Uuid
  scholarshipId String      @map("scholarship_id") @db.Uuid
  actorLabel    String      @default("Administrator Back Office") @map("actor_label") @db.VarChar(180)
  action        String      @db.VarChar(80)
  oldValue      Json?       @map("old_value")
  newValue      Json?       @map("new_value")
  reason        String?     @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@index([scholarshipId, createdAt])
  @@map("scholarship_history")
}

model ReconciliationHistory {
  id                String          @id @default(uuid()) @db.Uuid
  reconciliationId  String          @map("reconciliation_id") @db.Uuid
  actorLabel        String          @default("Administrator Back Office") @map("actor_label") @db.VarChar(180)
  action            String          @db.VarChar(80)
  oldValue          Json?           @map("old_value")
  newValue          Json?           @map("new_value")
  reason            String?         @db.VarChar(1000)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
