model CeremonyPeriod {
  id                String                 @id @default(uuid()) @db.Uuid
  code              String?                @unique @db.VarChar(40)
  name              String                 @db.VarChar(180)
  date              DateTime               @db.Date
  location          String                 @db.VarChar(240)
  capacity          Int
